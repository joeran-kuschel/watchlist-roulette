# Copy to .env and adjust. .env is not committed.

# Database (the placeholders are for local use only)
POSTGRES_USER=watchlist
# Use only URL-safe characters (letters, digits, - . _ ~): the password is put into the connection URL
POSTGRES_PASSWORD=watchlist
POSTGRES_DB=watchlist

# Use a remote database instead of the Compose one: set DATABASE_URL (and DB_SSL=true if it needs SSL)
# and run the SQL files in backend/migrations/ on it by hand.
# DATABASE_URL=postgres://user:password@host:5432/dbname
DB_SSL=false

# Addresses the frontend is opened at (comma-separated). Only these may call the API from a browser.
CORS_ORIGIN=http://localhost:8080,http://localhost:5173

# Only for "npm run dev" in frontend/ (not used by Compose): where the dev server forwards /api to.
# API_PROXY_TARGET=http://localhost:3000

# TMDB enrichment. Create an "API Read Access Token" in your TMDB account settings (Settings > API).
# Without it, films stay "pending" and nothing is fetched.
TMDB_ACCESS_TOKEN=
TMDB_LANGUAGE=en-US
