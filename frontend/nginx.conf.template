# Rendered at container start by the nginx image (envsubst on /etc/nginx/templates), so the same image runs in
# Docker Compose and in Kubernetes:
#   BACKEND_URL             where /api is forwarded to (set in the Dockerfile; Kubernetes uses the full service name)
#   NGINX_LOCAL_RESOLVERS   the DNS server from /etc/resolv.conf, filled in by the image (NGINX_ENTRYPOINT_LOCAL_RESOLVERS=1)
server {
  listen 80;
  root /usr/share/nginx/html;
  index index.html;

  # CSV uploads go through here; the backend limits them to 5 MB
  client_max_body_size 6m;

  # Look the backend up again when its container or pod is replaced (valid for 10 s)
  resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;

  location /api/ {
    set $backend ${BACKEND_URL};
    proxy_pass $backend$request_uri;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
